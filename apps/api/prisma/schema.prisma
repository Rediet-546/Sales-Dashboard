generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String
  name          String
  role          String    @default("user")
  roleId        String?
  tenantId      String?
  refreshToken  String?
  lastLogin     DateTime?
  team          String?   // Sales Team, Marketing Team, etc.
  department    String?   // Sales, Marketing, Engineering, etc.
  isActive      Boolean   @default(true)
  phone         String?
  avatar        String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  dashboards    Dashboard[]
  alerts        Alert[]
  metrics       Metric[]
  reports       Report[]
  nlpQueries    NLPQuery[]
  whatIfScenarios WhatIfScenario[]
  activities    Activity[]
  salesRecords  SalesRecord[]
}

model Dashboard {
  id          String    @id @default(cuid())
  name        String
  description String?
  type        String    @default("sales")
  isDefault   Boolean   @default(false)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  metrics     Metric[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Metric {
  id            String    @id @default(cuid())
  name          String
  description   String?
  value         Float
  unit          String?
  category      String
  isActive      Boolean   @default(true)
  tenantId      String?
  date          DateTime  @default(now())
  dashboardId   String
  dashboard     Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  alerts        Alert[]
  metricData    MetricData[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model MetricData {
  id        String   @id @default(cuid())
  metricId  String
  metric    Metric   @relation(fields: [metricId], references: [id], onDelete: Cascade)
  value     Float
  timestamp DateTime @default(now())
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([metricId, timestamp])
}

model Alert {
  id            String    @id @default(cuid())
  name          String
  condition     String
  threshold     Float
  status        String    @default("active")
  tenantId      String?
  isActive      Boolean   @default(true)
  lastTriggered DateTime?
  metricId      String
  metric        Metric    @relation(fields: [metricId], references: [id], onDelete: Cascade)
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Report {
  id          String    @id @default(cuid())
  name        String
  description String?
  type        String
  data        Json
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model NLPQuery {
  id          String    @id @default(cuid())
  query       String
  response    String
  confidence  Float     @default(0.0)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model WhatIfScenario {
  id          String    @id @default(cuid())
  name        String
  description String?
  change      Float
  impact      String
  confidence  Float     @default(0.0)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Activity {
  id          String    @id @default(cuid())
  action      String
  description String
  type        String
  metadata    Json?
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
}

model SalesRecord {
  id          String    @id @default(cuid())
  amount      Float
  currency    String    @default("USD")
  status      String    @default("pending")
  customer    String
  product     String
  quantity    Int       @default(1)
  date        DateTime  @default(now())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}