generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// ENUMS
// ============================================

enum Role {
  SUPER_ADMIN
  ADMIN
  MANAGER
  USER
  VIEWER
}

enum SaleStatus {
  PENDING
  COMPLETED
  CANCELLED
  REFUNDED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ApprovalType {
  PRICE_CHANGE
  DELETE_PRODUCT
  RETURN_REFUND
  STOCK_UPDATE
  PERMISSION_CHANGE
}

enum AlertType {
  STOCK
  SALES
  USER_ACTION
  SYSTEM
}

// ============================================
// USER & AUTH
// ============================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String
  name          String
  role          Role      @default(USER)
  team          String?
  department    String?
  isActive      Boolean   @default(true)
  phone         String?
  avatar        String?
  lastLogin     DateTime?
  
  // Shop/Store relation
  shopId        String?
  shop          Shop?     @relation(fields: [shopId], references: [id], onDelete: SetNull)
  
  // Manager - Subordinate relationship
  managerId     String?
  manager       User?     @relation("UserManager", fields: [managerId], references: [id])
  subordinates  User[]    @relation("UserManager")
  
  // Manager Permissions (for MANAGER role)
  permissions   ManagerPermission?
  
  // Relations
  products      Product[]
  salesRecords  SalesRecord[]
  activities    Activity[]
  dashboards    Dashboard[]
  alerts        Alert[]
  metrics       Metric[]
  reports       Report[]
  nlpQueries    NLPQuery[]
  whatIfScenarios WhatIfScenario[]
  
  // Approval Requests (as manager)
  managerRequests ApprovalRequest[] @relation("ManagerRequests")
  // Approval Requests (as admin)
  adminApprovals  ApprovalRequest[] @relation("AdminApprovals")
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// ============================================
// SHOPS & STORES
// ============================================

model Shop {
  id          String    @id @default(cuid())
  name        String
  description String?
  address     String?
  phone       String?
  email       String?
  currency    String    @default("USD")
  timezone    String    @default("UTC")
  isActive    Boolean   @default(true)
  logo        String?
  
  // Relations
  users       User[]
  settings    ShopSettings?
  products    Product[]
  salesRecords SalesRecord[]
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model ShopSettings {
  id                String   @id @default(cuid())
  shopId            String   @unique
  shop              Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  taxRate           Float    @default(0)
  invoicePrefix     String   @default("INV-")
  receiptFooter     String?
  theme             String   @default("light")
  lowStockThreshold Int      @default(5)
  dateFormat        String   @default("MM/DD/YYYY")
  timeFormat        String   @default("12h")
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// ============================================
// MANAGER PERMISSIONS
// ============================================

model ManagerPermission {
  id                String   @id @default(cuid())
  managerId         String   @unique
  manager           User     @relation(fields: [managerId], references: [id], onDelete: Cascade)
  
  // Permissions
  canManageProducts Boolean  @default(false)
  canCreateProducts Boolean  @default(false)
  canEditPricing    Boolean  @default(false)
  canViewReports    Boolean  @default(false)
  canManageTeam     Boolean  @default(false)
  canProcessReturns Boolean  @default(false)
  
  // Restrictions
  department        String?
  categories        String[] // Assigned categories
  maxDiscount       Float?   // Maximum discount percentage allowed
  approvalRequired  Boolean  @default(true)
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// ============================================
// APPROVAL REQUESTS
// ============================================

model ApprovalRequest {
  id          String         @id @default(cuid())
  type        ApprovalType
  status      ApprovalStatus @default(PENDING)
  requestData Json
  reason      String?
  
  managerId   String
  manager     User           @relation("ManagerRequests", fields: [managerId], references: [id])
  
  adminId     String
  admin       User           @relation("AdminApprovals", fields: [adminId], references: [id])
  
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  resolvedAt  DateTime?
}

// ============================================
// PRODUCTS
// ============================================

model Product {
  id          String    @id @default(cuid())
  name        String
  description String?
  sku         String    @unique
  price       Float
  cost        Float?
  category    String
  stock       Int       @default(0)
  minStock    Int       @default(5)
  maxStock    Int?
  unit        String    @default("pcs")
  images      Json?
  isActive    Boolean   @default(true)
  barcode     String?
  qrCode      String?
  
  shopId      String?
  shop        Shop?     @relation(fields: [shopId], references: [id], onDelete: SetNull)
  
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  salesRecords SalesRecord[]
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// ============================================
// SALES & TRANSACTIONS
// ============================================

model SalesRecord {
  id          String      @id @default(cuid())
  invoice     String      @unique
  amount      Float
  discount    Float       @default(0)
  tax         Float       @default(0)
  total       Float
  currency    String      @default("USD")
  status      SaleStatus  @default(PENDING)
  paymentMethod String    @default("CASH")
  customer    String?
  customerEmail String?
  customerPhone String?
  notes       String?
  
  productId   String?
  product     Product?    @relation(fields: [productId], references: [id])
  quantity    Int         @default(1)
  
  shopId      String?
  shop        Shop?       @relation(fields: [shopId], references: [id], onDelete: SetNull)
  
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  date        DateTime    @default(now())
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

// ============================================
// DASHBOARD & ANALYTICS
// ============================================

model Dashboard {
  id          String    @id @default(cuid())
  name        String
  description String?
  type        String    @default("sales")
  isDefault   Boolean   @default(false)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  metrics     Metric[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Metric {
  id            String    @id @default(cuid())
  name          String
  description   String?
  value         Float
  unit          String?
  category      String
  isActive      Boolean   @default(true)
  date          DateTime  @default(now())
  dashboardId   String
  dashboard     Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  alerts        Alert[]
  metricData    MetricData[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model MetricData {
  id        String   @id @default(cuid())
  metricId  String
  metric    Metric   @relation(fields: [metricId], references: [id], onDelete: Cascade)
  value     Float
  timestamp DateTime @default(now())
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([metricId, timestamp])
}

// ============================================
// ALERTS & NOTIFICATIONS
// ============================================

model Alert {
  id            String    @id @default(cuid())
  name          String
  type          AlertType @default(STOCK)
  condition     String
  threshold     Float
  status        String    @default("active")
  isActive      Boolean   @default(true)
  lastTriggered DateTime?
  message       String?
  
  metricId      String?
  metric        Metric?   @relation(fields: [metricId], references: [id], onDelete: SetNull)
  
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  shopId        String?
  department    String?   // For manager-specific alerts
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// ============================================
// REPORTS
// ============================================

model Report {
  id          String    @id @default(cuid())
  name        String
  description String?
  type        String
  data        Json
  filters     Json?
  
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  shopId      String?
  department  String?
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// ============================================
// ACTIVITY LOGS
// ============================================

model Activity {
  id          String    @id @default(cuid())
  action      String
  description String
  type        String
  metadata    Json?
  
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  shopId      String?
  ipAddress   String?
  userAgent   String?
  
  createdAt   DateTime  @default(now())
}

// ============================================
// NLP & AI
// ============================================

model NLPQuery {
  id          String    @id @default(cuid())
  query       String
  response    String
  confidence  Float     @default(0.0)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model WhatIfScenario {
  id          String    @id @default(cuid())
  name        String
  description String?
  change      Float
  impact      String
  confidence  Float     @default(0.0)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}